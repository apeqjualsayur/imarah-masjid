# Copy to .env.local and fill in. NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender for invitation emails, on a domain verified in Resend.
# Example: Imarah <jemputan@imarahmasjid.my>. Empty uses Resend's test sender.
RESEND_FROM=
SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3009
# Dev only. The seed script and isolation tests refuse to run unless this is "dev".
# Never set it for production.
IMARAH_DB_ENV=
# Dev only. Password for the fake seed users.
SEED_USER_PASSWORD=
